          "shona": "mhoroi ambuya",
          "english": "hello, grandmother (respectful)",
          "pronunciation": "mho-ro-i am-bu-ya",
          "audioUrl": null,
          "usageNote": "use mhoroi (with -i) when greeting elders. always greet before saying anything else.",
          "needs_verification": false
        },
        {
          "shona": "ndinonzi [your name]",
          "english": "my name is [your name]",
          "pronunciation": "ndi-no-nzi",
          "audioUrl": null,
          "usageNote": "introduce yourself even on the phone — gogo may not recognise the number.",
          "needs_verification": false
        },
        {
          "shona": "makadii ambuya?",
          "english": "how are you, grandmother?",
          "pronunciation": "ma-ka-dii am-bu-ya",
          "audioUrl": null,
          "usageNote": "always ask after their wellbeing right after greeting. cutting straight to business is rude.",
          "needs_verification": false
        },
        {
          "shona": "ndiripo, ndatenda",
          "english": "i am well, thank you",
          "pronunciation": "ndi-ri-po nda-ten-da",
          "audioUrl": null,
          "usageNote": "the standard polite reply when someone asks how you are.",
          "needs_verification": false
        },
        {
          "shona": "muri kuitei ambuya?",
          "english": "what are you doing, grandmother?",
          "pronunciation": "mu-ri ku-i-tei am-bu-ya",
          "audioUrl": null,
          "usageNote": "a warm small-talk opener — gives gogo room to share about her day.",
          "needs_verification": false
        },
        {
          "shona": "munhu wese ari sei?",
          "english": "how is everyone?",
          "pronunciation": "mu-nhu we-se a-ri sei",
          "audioUrl": null,
          "usageNote": "asks after the whole household — important in collective culture.",
          "needs_verification": false
        },
        {
          "shona": "fambai zvakanaka ambuya",
          "english": "go well, grandmother (goodbye)",
          "pronunciation": "fam-bai zva-ka-na-ka am-bu-ya",
          "audioUrl": null,
          "usageNote": "the standard farewell — wishes them a safe journey through the rest of the day.",
          "needs_verification": false
        }
